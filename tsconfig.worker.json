{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "types": ["@cloudflare/vitest-plugin/types"]
  },
  "include": ["src/worker/**/*.ts", "src/party/**/*.ts", "src/shared/**/*.ts", "src/kit/worker/**/*.ts", "src/kit/shared/**/*.ts", "test/**/*.ts", "e2e/forced/worker.ts"],
  // Browser-only client code under test: checked by tsconfig.node.json, which has the DOM types.
  "exclude": ["test/client/**"]
}
