{
  "name": "who-am-i",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "node scripts/ensure-dev-vars.mjs",
    "dev": "npm run setup && vite build && wrangler dev",
    "dev:ui": "vite",
    "build": "vite build && node scripts/check-bundle.mjs && wrangler deploy --dry-run --outdir dist/worker",
    "cf-typegen": "wrangler types src/worker/worker-configuration.d.ts",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.worker.json && tsc -p tsconfig.node.json",
    "lint": "eslint .",
    "test": "vitest run",
    "e2e": "vite build && node scripts/check-bundle.mjs && playwright test",
    "release": "release-kit release",
    "release:check": "release-kit check && npm run lint && npm run typecheck && npm test && npm run build",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "lean-qr": "^2.7.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.5.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "release-kit": "github:n8watkins/release-kit#v2.6.0",
    "tailwindcss": "^4.3.4",
    "typescript": "5.9",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "4.1",
    "wrangler": "^4.157.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.28.2": true,
    "workerd@1.20260815.1": true,
    "workerd@1.20261103.1": true
  }
}
