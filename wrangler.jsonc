{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "who-am-i-game",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Served at https://whoami.n8builds.dev, a Workers custom domain that
  // Cloudflare creates the DNS record and certificate for on deploy. The
  // workers.dev address and version preview URLs are off, so all traffic goes
  // through the zone (bot rules, cache).
  "routes": [{ "pattern": "whoami.n8builds.dev", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  // Keeps variables set in the Cloudflare dashboard across deploys. The one the game reads is
  // PICTURES: set it to "off" there to turn identity pictures off (text-only cards) at once,
  // with no code change; delete it to turn them back on. See README, "Pictures".
  "keep_vars": true,
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // /assets/* goes through the Worker so a missing hashed file is a 404, not the SPA fallback
    // (src/worker/assets.ts). Present files still come back from the asset layer unchanged.
    "run_worker_first": ["/healthz", "/api/*", "/s/*", "/assets/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "RoomDurableObject" },
      { "name": "RATE_LIMITER", "class_name": "RateLimiterDurableObject" },
      { "name": "PINS", "class_name": "PinDirectoryDurableObject" }
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "who-am-i",
      "database_id": "23259c6d-8f58-47cc-8e70-c2e52a29d632",
      "migrations_dir": "migrations"
    }
  ],
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RoomDurableObject", "RateLimiterDurableObject"] },
    { "tag": "v2", "new_sqlite_classes": ["PinDirectoryDurableObject"] }
  ]
}
